#!/usr/bin/env bash
# Corre tests/test_rerun.sh antes de aceptar un push. Aborta el push
# si alguna prueba falla. Requiere pdflatex.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

echo "pre-push: corriendo tests/test_rerun.sh..."
if ! "$repo_root/tests/test_rerun.sh"; then
  echo ""
  echo "pre-push: test_rerun.sh falló, push abortado."
  echo "(usa 'git push --no-verify' para saltar esta prueba)"
  exit 1
fi
